maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=yelp
pkgver=49.1
pkgrel=0
# Meson, C. No systemd/elogind touchpoint - the GNOME help browser.
source="https://download.gnome.org/sources/yelp/49/yelp-$pkgver.tar.xz"
sha256sums="3e3e94ef2d2c9487cc51062e3afbfa1578cebd29d80c84357b6d7ee6dcfd8a74  yelp-$pkgver.tar.xz"
# yelp-xsl is this repo's own package, not an apk stand-in - build it
# inline below, same pattern gnome-shell uses for mutter. libgcrypt-dev
# added to match Alpine's real aports recipe (community/yelp) - was
# missing from the earlier draft.
makedepends="bzip2-dev glib-dev gtk4.0-dev libadwaita-dev libgcrypt-dev libxml2-dev libxslt-dev sqlite-dev webkit2gtk-6.0-dev xz-dev"

build() {
    # yelp-xsl isn't a real apk/ledger package - it's our own recipe,
    # already in this repo but not published anywhere yet. Build it
    # the same way gnome-shell builds mutter inline: run ci/build.sh
    # on it from the repo root, then unpack the .zex it produces
    # straight into /overlayer/syshub before meson looks for it.
    echo "-- building yelp-xsl first (not published yet, bundled here) --"
    ( cd "$OUT_DIR" && sh ci/build.sh yelp-xsl )
    "${SUBSTRATE:-substrate}" unpack "$OUT_DIR"/yelp-xsl-*.zex --output /overlayer/syshub

    export PKG_CONFIG_PATH="/overlayer/syshub/lib/pkgconfig:/overlayer/syshub/share/pkgconfig:${PKG_CONFIG_PATH:-}"

    meson setup builddir \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        -Dlzma=enabled \
        -Dbzip2=enabled
    ninja -C builddir
    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    cp -a "$inst"/. "$PAYLOAD_DIR"/
}
