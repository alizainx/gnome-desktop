maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=gnome-keyring
pkgver=48.0
pkgrel=0
# 'systemd' here is a plain optional meson_feature ("Add support for
# systemd socket activation"), confirmed against the tarball's own
# meson_options.txt - there's no elogind counterpart to fall back to,
# it just drops the socket-activation integration entirely when
# disabled. No patch needed. pam=false: no PAM stack packaged in this
# repo yet, matches the same call made for polkit.
source="https://download.gnome.org/sources/gnome-keyring/48/gnome-keyring-$pkgver.tar.xz"
sha256sums="f20518c920e9ea3f9c9b8b44be8c50d8d7feecd0dd5624960f77bd2ca4fbeb9d  gnome-keyring-$pkgver.tar.xz"
# Wrong gcr package fixed: meson.build's dependency('gck-1', '>=3.3.4')
# and dependency('gcr-base-3', '>=3.27.90') are the OLD gcr-3.x
# pkgconfig modules, not gcr-4. Alpine ships two separate gcr
# packages precisely for this split - community/gcr (3.41.2, has
# gck-1.pc + gcr-base-3.pc) and community/gcr4 (4.x, gcr-4.pc only).
# gcr4-dev would configure-fail here; gcr-dev is the real match.
makedepends="openssh libcap-ng-dev glib-dev gcr-dev libgcrypt-dev p11-kit-dev"

# Deps this recipe assumes, none published yet: glib, gcr, libgcrypt,
# p11-kit. Will not configure until these exist. caps (libcap-ng) and
# selinux both off, neither is packaged.
build() {
    export PKG_CONFIG_PATH="/overlayer/syshub/lib/pkgconfig:/overlayer/syshub/share/pkgconfig:${PKG_CONFIG_PATH:-}"

    meson setup builddir \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        -Dssh-agent=true \
        -Dselinux=disabled \
        -Dsystemd=disabled \
        -Dpam=false \
        -Dmanpage=false \
        -Ddebug-mode=false
    ninja -C builddir
    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/bin" "$PAYLOAD_DIR/lib" "$PAYLOAD_DIR/libexec" "$PAYLOAD_DIR/share"
    cp -a "$inst"/bin/. "$PAYLOAD_DIR/bin/" 2>/dev/null || true
    cp -a "$inst"/lib/. "$PAYLOAD_DIR/lib/" 2>/dev/null || true
    rm -rf "$PAYLOAD_DIR/lib/pkgconfig"
    find "$PAYLOAD_DIR/lib" -maxdepth 1 \( -name '*.a' -o -name '*.la' \) -delete
    cp -a "$inst"/libexec/. "$PAYLOAD_DIR/libexec/" 2>/dev/null || true
    cp -a "$inst"/share/. "$PAYLOAD_DIR/share/" 2>/dev/null || true
}
