maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=gnome-color-manager
pkgver=3.36.2
pkgrel=0
# Meson, C. No systemd/elogind touchpoint. Man pages need
# docbook-sgml-utils/docbook-sgml-dtd (BDEPEND in the Gentoo ebuild),
# not published here yet - if the meson run below fails on that,
# it's a missing BDEPEND, not a flag to toggle off.
source="https://download.gnome.org/sources/gnome-color-manager/3.36/gnome-color-manager-$pkgver.tar.xz"
sha256sums="3904d42abb4ea566df0b880e82bf0b9f86386c692f15b318469a4c7be33a887f  gnome-color-manager-$pkgver.tar.xz"
makedepends="glib-dev gtk+3.0-dev colord-dev lcms2-dev itstool"

# Deps this recipe assumes, none published yet: glib, gtk3, colord,
# lcms2.
build() {
    meson setup builddir \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        -Dtests=false
    ninja -C builddir
    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/bin" "$PAYLOAD_DIR/share"
    cp -a "$inst"/bin/. "$PAYLOAD_DIR/bin/" 2>/dev/null || true
    cp -a "$inst"/share/. "$PAYLOAD_DIR/share/" 2>/dev/null || true

    # .desktop files hardcode Exec=/usr/bin/... - substrate's payload
    # check rejects any /usr text reference regardless of source.
    # Skip real ELF binaries - sed -i rewriting one as text corrupts
    # it (byte-length shift breaks internal offsets), bit gnome-user-
    # share's package() hit for real.
    grep -RIl '/usr/' "$PAYLOAD_DIR" 2>/dev/null | while IFS= read -r f; do
        magic="$(od -An -tx1 -N4 "$f" 2>/dev/null | tr -d ' \n')"
        [ "$magic" = "7f454c46" ] && continue
        sed -i 's#/usr/#/overlayer/syshub/#g' "$f"
    done
}
