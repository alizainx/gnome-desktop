maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=evolution-data-server
pkgver=3.60.2
pkgrel=0
# CMake, not meson - Gentoo's own evolution-data-server-3.60.2.ebuild
# inherits "cmake", not "meson". No systemd/elogind dependency
# anywhere in this package at all - bucket A, no patch needed.
source="https://download.gnome.org/sources/evolution-data-server/3.60/evolution-data-server-$pkgver.tar.xz"
sha256sums="2084dbdac396371b365d504c1ff45866ba8dca2f1252e5da1d3d9c33abdc1286  evolution-data-server-$pkgver.tar.xz"
# makedepends and build() flags matched against Alpine's real aports
# recipe (community/evolution-data-server) - was missing gcr-dev.
# Alpine only forces 8 flags and leaves everything else (krb5, ldap,
# gtk3/4, weather, canberra, vala, tests) on CMake's own auto-detection
# against whatever -dev packages are present, rather than force-OFF -
# matched that here instead of disabling features we do have deps for.
makedepends="bison boost-dev cmake flex gcr-dev glib-dev gnome-online-accounts-dev gnu-libiconv-dev gobject-introspection-dev gperf gtk+3.0-dev gtk4.0-dev icu-dev intltool json-glib-dev krb5-dev libcanberra-dev libgweather4-dev libical-dev libphonenumber-dev libsecret-dev libsoup3-dev libxml2-dev nspr-dev nss-dev openldap-dev samurai sqlite-dev vala webkit2gtk-6.0-dev zlib-dev"

# WITH_SYSTEMDUSERUNITDIR defaults to installing unit files under
# $prefix/lib/systemd/user (CMakeLists.txt line ~250) unless explicitly
# set to "no". Alpine doesn't set this either (no systemd.pc on their
# system, so it auto-skips) but we set it explicitly anyway - harmless,
# and clearer than relying on the same absence-of-systemd.pc detection.
#
# WITH_..._CLIENT_ID="": data/CMakeLists.txt's default (non-empty,
# obfuscated placeholder) triggers a CHECK_C_SOURCE_RUNS that compiles
# e-oauth2-service.c standalone and executes it during configure to
# decode the OAuth2 URL scheme - a build-time-only helper that hits
# the same class of problem as g-ir-scanner's dumper (see ci/build.sh's
# bootstrap-libs comment), except silently ("Test _decoded - Failed",
# no relocation detail). Not worth chasing further - Google/Yahoo/
# Outlook OAuth2 branding isn't functionally required, empty strings
# skip the whole guarded block per CMakeLists.txt's own
# `if(NOT WITH_GOOGLE_CLIENT_ID STREQUAL "")`.
build() {
    cmake -S . -B builddir \
        -DCMAKE_INSTALL_PREFIX=/overlayer/syshub \
        -DCMAKE_INSTALL_LIBDIR=/overlayer/syshub/lib \
        -DCMAKE_INSTALL_INCLUDEDIR=/overlayer/syshub/include \
        -DSYSCONF_INSTALL_DIR=/overlayer/syshub/etc \
        -DCMAKE_BUILD_TYPE=None \
        -DWITH_SYSTEMDUSERUNITDIR=no \
        -DENABLE_GOA=ON \
        -DENABLE_INTROSPECTION=ON \
        -DENABLE_VALA_BINDINGS=ON \
        -DWITH_PHONENUMBER=ON \
        -DWITH_LIBDB=OFF \
        -DENABLE_SCHEMAS_COMPILE:BOOL=OFF \
        -DENABLE_OAUTH2_WEBKITGTK=OFF \
        -DWITH_GOOGLE_CLIENT_ID="" \
        -DWITH_YAHOO_CLIENT_ID="" \
        -DWITH_OUTLOOK_CLIENT_ID=""
    cmake --build builddir
    DESTDIR="$(pwd)/_zexbuild-install" cmake --install builddir
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/bin" "$PAYLOAD_DIR/lib" "$PAYLOAD_DIR/libexec" "$PAYLOAD_DIR/share"
    cp -a "$inst"/bin/. "$PAYLOAD_DIR/bin/" 2>/dev/null || true
    cp -a "$inst"/lib/. "$PAYLOAD_DIR/lib/" 2>/dev/null || true
    rm -rf "$PAYLOAD_DIR/lib/pkgconfig" "$PAYLOAD_DIR/lib/cmake"
    find "$PAYLOAD_DIR/lib" -maxdepth 1 \( -name '*.a' -o -name '*.la' \) -delete
    cp -a "$inst"/libexec/. "$PAYLOAD_DIR/libexec/" 2>/dev/null || true
    cp -a "$inst"/share/. "$PAYLOAD_DIR/share/" 2>/dev/null || true
}
