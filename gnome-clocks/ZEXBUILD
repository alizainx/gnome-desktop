maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=gnome-clocks
pkgver=49.0
pkgrel=0
# Meson, Vala. No systemd/elogind touchpoint.
source="https://download.gnome.org/sources/gnome-clocks/49/gnome-clocks-$pkgver.tar.xz"
sha256sums="bf76915f2a492e8a0592fe40b35346593aa39e4e6881d6176e0efd8771d4e6fa  gnome-clocks-$pkgver.tar.xz"
# makedepends matched against Alpine's real aports recipe
# (community/gnome-clocks) - was missing desktop-file-utils,
# gettext-dev, gsound-dev, itstool, vorbis-tools.
makedepends="glib-dev gtk4.0-dev libgweather4-dev gnome-desktop-dev geocode-glib-dev geoclue-dev libadwaita-dev vala desktop-file-utils gettext-dev gsound-dev itstool vorbis-tools"

# Deps this recipe assumes, none published yet: glib, gtk4,
# libgweather, gnome-desktop, geocode-glib, geoclue, libadwaita, vala
# (host, for libgweather/libadwaita vapi files).
build() {
    meson setup builddir \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        -Dprofile=default \
        -Ddocs=false
    ninja -C builddir
    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/bin" "$PAYLOAD_DIR/share"
    cp -a "$inst"/bin/. "$PAYLOAD_DIR/bin/" 2>/dev/null || true
    cp -a "$inst"/share/. "$PAYLOAD_DIR/share/" 2>/dev/null || true
}
