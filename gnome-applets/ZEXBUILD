maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=gnome-applets
pkgver=3.58.0
pkgrel=0
# Autotools (gnome2 eclass upstream), applets for the gnome-panel
# already in this repo. No systemd/elogind dependency anywhere in the
# tree. No patch needed. tracker (tinysparql) support left off, not
# published here.
source="https://download.gnome.org/sources/gnome-applets/3.58/gnome-applets-$pkgver.tar.xz"
sha256sums="e61edb71344dcd5daa6e7175dfbb274a758be8b58452773569bb35645b85a238  gnome-applets-$pkgver.tar.xz"
# makedepends matched against Alpine's real aports recipe
# (community/gnome-applets) - was missing adwaita-icon-theme-dev,
# gnome-panel-dev, intltool, itstool.
makedepends="adwaita-icon-theme-dev glib-dev gnome-panel-dev gtk+3.0-dev gucharmap-dev intltool itstool libgtop-dev libgweather4-dev libnotify-dev libwnck3-dev libxml2-dev polkit-dev upower-dev libx11-dev pango-dev"

# Deps this recipe assumes, none published yet: gtk3, glib, gnome-panel,
# libgtop, libwnck, libnotify, upower, adwaita-icon-theme, libxml2,
# libgweather, gucharmap, polkit, libx11, pango.
build() {
    ./configure \
        --host="$CHOST" \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --disable-static \
        --enable-mini-commander \
        --disable-tracker-search-bar
    make
    make install DESTDIR="$(pwd)/_zexbuild-install"
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/bin" "$PAYLOAD_DIR/lib" "$PAYLOAD_DIR/share"
    cp -a "$inst"/bin/. "$PAYLOAD_DIR/bin/" 2>/dev/null || true
    cp -a "$inst"/lib/. "$PAYLOAD_DIR/lib/" 2>/dev/null || true
    rm -rf "$PAYLOAD_DIR/lib/pkgconfig"
    find "$PAYLOAD_DIR/lib" -maxdepth 1 \( -name '*.a' -o -name '*.la' \) -delete
    cp -a "$inst"/share/. "$PAYLOAD_DIR/share/" 2>/dev/null || true
}
