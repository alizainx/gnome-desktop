maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=gsettings-desktop-schemas
pkgver=49.1
pkgrel=0
# No systemd/elogind dependency at all upstream. No patches needed.
source="https://download.gnome.org/sources/gsettings-desktop-schemas/49/gsettings-desktop-schemas-$pkgver.tar.xz"
sha256sums="777a7f83d5e5a8076b9bf809cb24101b1b1ba9c230235e3c3de8e13968ed0e63  gsettings-desktop-schemas-$pkgver.tar.xz"
# gobject-introspection-dev dropped from Alpine's own real makedepends
# list - we build with -Dintrospection=false (no working exe_wrapper
# for cross builds yet), so the scanner is never invoked.
makedepends="glib-dev"

# Depends on glib (schema compiler at build time, GLib-Introspection
# scanner if enabled). Introspection off for now, same reasoning as
# the glib recipe: no working exe_wrapper for cross builds yet.
build() {
    meson setup builddir \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        -Dintrospection=false
    ninja -C builddir
    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR"
    cp -a "$inst"/. "$PAYLOAD_DIR"/
}
