maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=libgweather
pkgver=4.4.4
pkgrel=0
# No systemd/elogind dependency at all, confirmed against the real
# meson_options.txt (zoneinfo_dir, owm_apikey, enable_vala, gtk_doc,
# introspection, tests, soup2 - nothing session-related). No patch
# needed.
source="https://download.gnome.org/sources/libgweather/4.4/libgweather-$pkgver.tar.xz"
sha256sums="7017677753cdf7d1fdc355e4bfcdb1eba8369793a8df24d241427a939cbf4283  libgweather-$pkgver.tar.xz"
makedepends="glib-dev libsoup3-dev geocode-glib-dev libxml2-dev json-glib-dev"

# vala/introspection/gtk_doc/tests all off, same reasoning as every
# other recipe here.
build() {
    meson setup builddir \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        -Denable_vala=false \
        -Dgtk_doc=false \
        -Dintrospection=false \
        -Dtests=false \
        -Dsoup2=false
    ninja -C builddir
    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    cp -a "$inst"/. "$PAYLOAD_DIR"/
}
