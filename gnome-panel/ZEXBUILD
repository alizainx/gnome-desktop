maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=gnome-panel
pkgver=3.58.1
pkgrel=0

source="https://download.gnome.org/sources/gnome-panel/3.58/gnome-panel-$pkgver.tar.xz"

sha256sums="7e8bca43a81a134c666b3a78baf2affb0c5d30efb1bca653887fc41b31dd5e64  gnome-panel-$pkgver.tar.xz"

makedepends="
    itstool
    glib-dev
    gnome-desktop-dev
    gdk-pixbuf-dev
    pango-dev
    gtk+3.0-dev
    libwnck3-dev
    gnome-menus-dev
    gsettings-desktop-schemas-dev
    cairo-dev
    libgweather4-dev
    dconf-dev
    libx11-dev
    gdm-dev
    geocode-glib-dev
    polkit-dev
"

build() {
    # panel-run-dialog.c hard-#includes <libgnome-desktop/gnome-systemd.h>
    # and calls gnome_start_systemd_scope() unconditionally, no
    # HAVE_ELOGIND-style guard - this header isn't present in this CI
    # container's gnome-desktop-dev, so it must go. Checked against the
    # actual downloaded 3.58.1 tarball: the call is exactly 7 lines,
    # match line through "NULL);":
    #   gnome_start_systemd_scope (locale_command,
    #                              pid, NULL, NULL, NULL, NULL, NULL);
    # `+7d` (used twice before) deletes 8 lines - match + 7 - eating
    # the blank line *and* the enclosing block's closing brace right
    # after, which is what actually caused the cascading "invalid
    # storage class" errors from that point to EOF. `+6d` deletes
    # exactly match + 6 continuation lines = the whole statement, no
    # more.
    sed -i '/#include <libgnome-desktop\/gnome-systemd\.h>/d' \
        modules/action-button/panel-run-dialog.c
    sed -i '/gnome_start_systemd_scope (locale_command,/,+6d' \
        modules/action-button/panel-run-dialog.c

    local action_modules="gio-unix-2.0 gtk+-3.0 libgnome-menu-3.0 libelogind x11"
    local launcher_modules="gio-unix-2.0 gtk+-3.0 libgnome-menu-3.0 libelogind"
    local menu_modules="gdm gio-unix-2.0 gtk+-3.0 libgnome-menu-3.0 libelogind"

    ./configure \
        --host="$CHOST" \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --disable-static \
        --disable-eds \
        ACTION_BUTTON_CFLAGS="$(pkg-config --cflags $action_modules)" \
        ACTION_BUTTON_LIBS="$(pkg-config --libs $action_modules)" \
        LAUNCHER_CFLAGS="$(pkg-config --cflags $launcher_modules)" \
        LAUNCHER_LIBS="$(pkg-config --libs $launcher_modules)" \
        MENU_CFLAGS="$(pkg-config --cflags $menu_modules)" \
        MENU_LIBS="$(pkg-config --libs $menu_modules)"

    make
    make install DESTDIR="$(pwd)/_zexbuild-install"
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"

    mkdir -p "$PAYLOAD_DIR"

    cp -a "$inst"/. "$PAYLOAD_DIR"/
}
