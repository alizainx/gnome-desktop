maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=librsvg
pkgver=2.62.3
pkgrel=0

# Rewritten from scratch - the previous version used a hand-rolled
# meson cross-file pointing rustc at a nonexistent
# targets/x86_64-zainium-linux-musl.json (that whole cross-compile
# plumbing was never wired up: $RECIPE_ROOT isn't even a variable
# ci/build.sh sets, "parameter not set" under set -u). Every other
# recipe in this repo does a NATIVE build inside the Alpine container
# --host="$CHOST" is just triple-tagging, not real cross-compilation,
# same as gnome-shell/evolution-data-server/etc - librsvg needs the
# same treatment, not its own architecture. Alpine's real librsvg
# APKBUILD (community/librsvg) is a plain native abuild-meson build
# with cargo/cargo-c fetching from crates.io normally (options="net"),
# no offline vendoring - dropped the gentoo-crate-dist crates tarball
# too, this CI container has network access same as Alpine's builders
# do (substrate itself gets cargo-installed from crates.io in the
# same job).
source="https://download.gnome.org/sources/librsvg/2.62/librsvg-$pkgver.tar.xz"
sha256sums="7eb449b2722a768021356f66dfee3202c229b54ed4e6a70ce40c090e97ff16f2  librsvg-$pkgver.tar.xz"

# Matches Alpine's real makedepends verbatim, minus font-dejavu/
# gi-docgen/py3-docutils/git (only needed for Alpine's disabled test/
# doc/git-init steps - we don't run check(), so skipped same as
# Alpine's own default `want_check` false path does).
makedepends="bzip2-dev cairo-dev cargo cargo-c dav1d-dev gdk-pixbuf-dev glib-dev gobject-introspection-dev libgsf-dev meson vala"

build() {
    # librsvg's build.rs runs `git describe` for its version string
    # and fails without a repo present - Alpine's prepare() does the
    # same `git init -q` for this exact reason.
    git init -q

    export RUSTFLAGS="${RUSTFLAGS:-} -C debuginfo=1"

    # Rsvg-2.0's g-ir-scanner dumper carries Zainium's interpreter/
    # rpath like every other build product - same fix as gnome-shell/
    # gnome-desktop/gnome-characters's own dumpers.
    export LD_LIBRARY_PATH="/usr/lib:/lib:${LD_LIBRARY_PATH:-}"

    meson setup builddir \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        -Dintrospection=enabled \
        -Dpixbuf=enabled \
        -Dpixbuf-loader=disabled \
        -Dvala=enabled \
        -Dtests=false \
        -Davif=enabled \
        --strip

    ninja -C builddir
    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR"
    cp -a "$inst"/. "$PAYLOAD_DIR"/
}
