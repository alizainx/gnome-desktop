maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=networkmanager
pkgver=1.56.1
pkgrel=0

# The actual network management daemon (nm-applet's backend) - was
# missing from this repo entirely, only the tray applet existed.
# Ported from Alpine's real aports recipe (community/networkmanager),
# collapsed onto one payload instead of Alpine's ~15 subpackage split
# (adsl/bluetooth/ovs/ppp/wwan/gtkdoc/tui/... - niche device plugins
# and docs this OS doesn't need yet). Kept -Dsession_tracking=elogind
# and -Dsuspend_resume=elogind unchanged - this is exactly what
# qlogind's libelogind.pc alias exists for (see quantra-logind).
source="https://gitlab.freedesktop.org/NetworkManager/NetworkManager/-/archive/$pkgver/NetworkManager-$pkgver.tar.gz"
sha256sums="e40f24c2dc9f8408c8183e495f3b5d783204d116c8f23100d00c714ac4ed9252  NetworkManager-$pkgver.tar.gz"

# Matches Alpine's real makedepends, minus gtk-doc/py3-gobject3/
# python3 (docs and check() helpers, we don't run either), ppp-dev/
# libnvme-dev/newt-dev (ppp/nvme/tui plugins we're not packaging as
# subpackages), openresolv (Alpine-init-specific resolver hook).
makedepends="bash curl-dev dbus-dev elogind-dev eudev-dev gettext-dev gnutls-dev gobject-introspection-dev jansson-dev libgudev-dev libndp-dev libnl3-dev libpsl-dev libxslt linux-headers meson mobile-broadband-provider-info modemmanager-dev nss-dev polkit-dev readline-dev util-linux-dev vala wireless-regdb"

build() {
    # NetworkManager-<ver>.tar.gz's GitLab-archive root doesn't match
    # $pkgname-$pkgver (ci/build.sh's auto-cd assumes that) - cd
    # explicitly, same pattern as upower's v-prefixed tarball root.
    cd NetworkManager-$pkgver

    meson setup builddir \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        --sysconfdir=/overlayer/syshub/etc \
        --localstatedir=/overlayer/syshub/var \
        -Dconfig_dhcp_default=internal \
        -Dconfig_plugins_default=ifupdown \
        -Dcrypto=nss \
        -Ddbus_conf_dir=/overlayer/syshub/share/dbus-1/system.d \
        -Ddocs=false \
        -Difupdown=true \
        -Diwd=false \
        -Dlibaudit=no \
        -Dmodify_system=true \
        -Dofono=false \
        -Dpolkit=true \
        -Dppp=false \
        -Dqt=false \
        -Dselinux=false \
        -Dsystemd_journal=false \
        -Dsystemdsystemunitdir=no \
        -Dtests=no \
        -Dudev_dir=/overlayer/syshub/lib/udev \
        -Dvapi=true \
        -Dnmtui=false \
        -Dsession_tracking=elogind \
        -Dsuspend_resume=elogind
    ninja -C builddir
    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    # cwd is already NetworkManager-$pkgver here - build()'s explicit
    # cd persists into package() (same shell process, no subshell),
    # same as upower's v-prefix pattern.
    local inst="_zexbuild-install/overlayer/syshub"
    cp -a "$inst"/. "$PAYLOAD_DIR"/
}
