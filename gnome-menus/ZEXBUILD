maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=gnome-menus
pkgver=3.38.1
pkgrel=0
# Autotools (gnome2 eclass upstream), library + fd.o menu-spec layout
# data - no systemd/elogind dependency anywhere. No patch needed.
source="https://download.gnome.org/sources/gnome-menus/3.38/gnome-menus-$pkgver.tar.xz"
sha256sums="1198a91cdbdcfb232df94e71ef5427617d26029e327be3f860c3b0921c448118  gnome-menus-$pkgver.tar.xz"
makedepends="glib-dev"

# Deps this recipe assumes, none published yet: glib. Introspection off,
# same reasoning as every other recipe here: no working exe_wrapper for
# cross builds yet.
build() {
    ./configure \
        --host="$CHOST" \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --disable-static \
        --disable-introspection
    make
    make install DESTDIR="$(pwd)/_zexbuild-install"
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib" "$PAYLOAD_DIR/share"
    cp -a "$inst"/lib/. "$PAYLOAD_DIR/lib/" 2>/dev/null || true
    rm -rf "$PAYLOAD_DIR/lib/pkgconfig"
    find "$PAYLOAD_DIR/lib" -maxdepth 1 \( -name '*.a' -o -name '*.la' \) -delete
    cp -a "$inst"/share/. "$PAYLOAD_DIR/share/" 2>/dev/null || true
}
