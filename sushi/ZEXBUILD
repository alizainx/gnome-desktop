maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=sushi
pkgver=46.0
pkgrel=0
# Meson, GJS. No systemd/elogind touchpoint - a Nautilus quick-preview
# helper (D-Bus activated, spacebar preview).
source="https://download.gnome.org/sources/sushi/46/sushi-$pkgver.tar.xz"
sha256sums="96085baaa430ab2142c606aab5c47e2fbb2fd3eb70a352137e65c59a58a0f2c6  sushi-$pkgver.tar.xz"
# makedepends matched against Alpine's real aports recipe
# (community/sushi) - was missing evince-dev and webkit2gtk-4.1-dev:
# sushi's document/webpage preview panes are backed by
# EvinceDocument/EvinceView and a WebKitWebView respectively, real
# link deps for this meson build, not just runtime companions as the
# earlier draft assumed. bubblewrap/webkit2gtk added to depends= too
# (Alpine's real runtime depends=) - sushi sandboxes each preview
# through bubblewrap.
makedepends="evince-dev freetype-dev gdk-pixbuf-dev gjs-dev glib-dev gobject-introspection-dev gst-plugins-base-dev gstreamer-dev gtk+3.0-dev gtksourceview4-dev harfbuzz-dev libepoxy-dev webkit2gtk-4.1-dev"

build() {
    meson setup builddir \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        -Dwayland=true \
        -DX11=true \
        -Dprofile=default
    ninja -C builddir
    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    cp -a "$inst"/. "$PAYLOAD_DIR"/
}
