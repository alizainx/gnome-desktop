maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=gucharmap
pkgver=17.0.2
pkgrel=0
# No systemd/elogind dependency at all, confirmed against the real
# meson_options.txt (charmap, dbg, docs, gir, gtk3, ucd_path, vapi -
# nothing session-related). No patch needed. Gentoo's own
# 14.0.1-install-user-help.patch is an unrelated docs-install fix, not
# carried here.
source="https://download.gnome.org/sources/gucharmap/17.0/gucharmap-$pkgver.tar.xz"
sha256sums="4723972cafab688af4dd927cf458e579ddaea54865d81b7c1e868f3ebbdf00aa  gucharmap-$pkgver.tar.xz"
makedepends="glib-dev gtk+3.0-dev pango-dev cairo-dev freetype-dev pcre2-dev at-spi2-core-dev itstool"

# gir/vapi off, same reasoning as every other recipe here.
build() {
    meson setup builddir \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        -Dcharmap=true \
        -Ddbg=false \
        -Ddocs=false \
        -Dgir=false \
        -Dgtk3=true \
        -Ducd_path=/overlayer/syshub/share/unicode-data \
        -Dvapi=false
    ninja -C builddir
    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    cp -a "$inst"/. "$PAYLOAD_DIR"/
}
