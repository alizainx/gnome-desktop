maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=gnome-tweaks
pkgver=49.0
pkgrel=0
# Meson, Python (pygobject). No systemd/elogind touchpoint.
source="https://download.gnome.org/sources/gnome-tweaks/49/gnome-tweaks-$pkgver.tar.xz"
sha256sums="b3909bdcb4905b68427d6ab581e01f436dff8e5c0a389b1e0b14500f18806ebb  gnome-tweaks-$pkgver.tar.xz"
# Verified against Alpine's own real gnome-tweaks APKBUILD makedepends.
makedepends="desktop-file-utils libadwaita-dev libgudev-dev gettext-dev gobject-introspection-dev gsettings-desktop-schemas-dev py3-gobject3-dev"

# Deps this recipe assumes, none published yet: python3, pygobject,
# gsettings-desktop-schemas, gnome-settings-daemon, glib,
# gobject-introspection, gtk4, libadwaita, libgudev, gnome-desktop,
# libnotify, pango, mutter, gnome-shell, sound-theme-freedesktop.
build() {
    meson setup builddir \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include
    ninja -C builddir
    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR"
    cp -a "$inst"/. "$PAYLOAD_DIR"/

    # gtweak/gsettings.py and gshellwrapper.py hardcode
    # GSETTINGS_SCHEMA_DIR = "/usr/share/glib-2.0/schemas/" as a
    # Python string literal - substrate's payload check rejects any
    # /usr text reference regardless of source.
    grep -RIl '/usr/' "$PAYLOAD_DIR" 2>/dev/null | while IFS= read -r f; do
        sed -i 's#/usr/#/overlayer/syshub/#g' "$f"
    done
}
