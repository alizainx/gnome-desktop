maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=gnome-settings-daemon
pkgver=50.1
pkgrel=0

source="https://download.gnome.org/sources/gnome-settings-daemon/50/gnome-settings-daemon-$pkgver.tar.xz"

sha256sums="dd2c9730914f0ececa0229dd8a8c2940a57ddeb0802434558d4b164d79cfe05c  gnome-settings-daemon-$pkgver.tar.xz"

makedepends="\
glib-dev \
gnome-desktop-dev \
gsettings-desktop-schemas-dev \
gtk+3.0-dev \
alsa-lib-dev \
elogind-dev \
geoclue-dev \
geocode-glib-dev \
libcanberra-dev \
libgweather4-dev \
libnotify-dev \
pango-dev \
polkit-dev \
pulseaudio-dev \
upower-dev \
libgudev-dev \
wayland-dev \
fontconfig-dev \
networkmanager-dev"

build() {
    export LD_LIBRARY_PATH="/overlayer/syshub/lib:/usr/lib:/lib"

    meson setup builddir \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        -Dsystemd=false \
        -Delogind=true \
        -Dalsa=true \
        -Dgudev=true \
        -Dgcr3=false \
        -Dcolord=false \
        -Dcups=false \
        -Dnetwork_manager=true \
        -Drfkill=true \
        -Dsmartcard=false \
        -Dxwayland=false \
        -Dwwan=false

    ninja -C builddir

    DESTDIR="$(pwd)/_zexbuild-install" \
        ninja -C builddir install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"

    mkdir -p "$PAYLOAD_DIR"
    cp -a "$inst"/. "$PAYLOAD_DIR"/
}
