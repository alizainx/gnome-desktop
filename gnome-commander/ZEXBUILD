maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=gnome-commander
pkgver=1.18.6
pkgrel=0
# Meson, C++. Deliberately pinned to the last pre-Rust release: the
# current gnome-commander (2.x) rewrote its core in Rust and needs
# cargo crate vendoring, same unresolved Rust CI plumbing blocker as
# quantra-logind/librsvg. 1.18.6 is plain C++/meson, no Rust anywhere.
# No systemd/elogind touchpoint either way.
source="https://download.gnome.org/sources/gnome-commander/1.18/gnome-commander-$pkgver.tar.xz"
sha256sums="ca11736869c3e08aa0a12d8caf1e1ce79679365b177c07eb4ab810cd4da4c8cb  gnome-commander-$pkgver.tar.xz"
makedepends="glib-dev gtk+3.0-dev gdk-pixbuf-dev"

# Deps this recipe assumes, none published yet: glib, gtk3,
# gdk-pixbuf. exif/gsf/pdf/samba/taglib support and doc (needs yelp)
# left off to minimize the dependency edge.
build() {
    meson setup builddir \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        -Dexiv2=disabled \
        -Dlibgsf=disabled \
        -Dpoppler=disabled \
        -Dsamba=disabled \
        -Dtaglib=disabled \
        -Dtests=disabled \
        -Dhelp=false
    ninja -C builddir
    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/bin" "$PAYLOAD_DIR/share"
    cp -a "$inst"/bin/. "$PAYLOAD_DIR/bin/" 2>/dev/null || true
    cp -a "$inst"/share/. "$PAYLOAD_DIR/share/" 2>/dev/null || true
}
