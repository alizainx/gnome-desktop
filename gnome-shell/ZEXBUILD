maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=gnome-shell
pkgver=49.9
pkgrel=0
# 0001-shell-elogind-support-to-avoid-stubbed-sd_notify.patch: real
# upstream-style patch (Swagtoy, carried by Gentoo's gnome-shell
# ebuild). With -Dsystemd=false, meson.build falls back to
# dependency('libelogind', required: false) and defines HAVE_ELOGIND,
# which src/shell-util.c then uses for a real sd_notify/sd_notifyf
# instead of the no-op stub. Confirmed against the patch itself:
# `#include <elogind/sd-daemon.h>` when HAVE_ELOGIND is set. qlogind's
# libelogind.pc alias must therefore also install headers under an
# elogind/ subdirectory, not just a qlogind/ one, for this include to
# resolve.
source="https://download.gnome.org/sources/gnome-shell/49/gnome-shell-$pkgver.tar.xz
0001-shell-elogind-support-to-avoid-stubbed-sd_notify.patch"
sha256sums="a9e60f1235d1f34c4e25fd70702f544ecdd2c164d9d18123787a3b96f9b984b8  gnome-shell-$pkgver.tar.xz"
# Cross-checked against Alpine's own real gnome-shell APKBUILD
# makedepends, trimmed of networkmanager-dev/libnma-dev (we build with
# -Dnetworkmanager=false) and gnome-bluetooth/gnome-control-center/
# tecla (no manifest dependency on those). sassc kept unconditionally -
# gnome-shell's build always compiles its scss stylesheet with it,
# not gated behind any meson option.
makedepends="elogind-dev evolution-data-server-dev gcr4-dev gjs-dev gnome-autoar-dev gnome-desktop-dev gobject-introspection-dev gstreamer-dev gtk4.0-dev ibus-dev json-glib-dev libcanberra-dev libxml2-dev mutter-dev pipewire-dev polkit-dev pulseaudio-dev sassc startup-notification-dev"

# Not published yet: mutter, gjs, gtk4, gnome-desktop, gnome-autoar,
# json-glib, ibus, pipewire, networkmanager. Will not configure until
# those exist.
build() {
    patch -p1 < ../0001-shell-elogind-support-to-avoid-stubbed-sd_notify.patch

    meson setup builddir \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        -Dsystemd=false \
        -Dcamera_monitor=false \
        -Dextensions_tool=true \
        -Dextensions_app=true \
        -Dgtk_doc=false \
        -Dman=false \
        -Dtests=false \
        -Dnetworkmanager=false \
        -Dportal_helper=false
    ninja -C builddir
    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR"
    cp -a "$inst"/. "$PAYLOAD_DIR"/
}
