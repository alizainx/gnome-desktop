source="https://download.gnome.org/sources/gnome-shell/50/gnome-shell-$pkgver.tar.xz
0001-shell-elogind-support-to-avoid-stubbed-sd_notify.patch"

sha256sums="c531939539db316a41aef23670370abd1330d3254f84bcb0f9f4dae5d6e362cf  gnome-shell-$pkgver.tar.xz"

makedepends="
    elogind-dev
    mutter-dev
    evolution-data-server-dev
    gcr4-dev
    gjs-dev
    gnome-autoar-dev
    gnome-desktop-dev
    gobject-introspection-dev
    gstreamer-dev
    gtk4.0-dev
    ibus-dev
    json-glib-dev
    libcanberra-dev
    libxml2-dev
    libx11-dev
    libxext-dev
    libxfixes-dev
    pipewire-dev
    polkit-dev
    pulseaudio-dev
    sassc
    startup-notification-dev
"

# -Dintrospection=false: St's GIR needs g-ir-scanner to run a freshly
# linked dumper binary against mutter-dev's own libmutter-clutter/cogl
# .so's from apk. Those fail to relocate in the CI container (musl
# ldso: "symbol not found" for glib/pango/cairo/graphene/atk/lcms2/
# EGL) - LD_LIBRARY_PATH pointing at /overlayer/syshub/lib first makes
# it worse, since that's build-time stand-ins, not what mutter-dev
# was actually linked against. Same class of problem our own mutter
# recipe already sidesteps with -Dintrospection=false. Matching that
# here until CI has a real Zainium-built mutter to link St against
# instead of Alpine's mutter-dev.
build() {
    patch -p1 < ../0001-shell-elogind-support-to-avoid-stubbed-sd_notify.patch

    export LD_LIBRARY_PATH="/overlayer/syshub/lib:${LD_LIBRARY_PATH:-}"
    export PKG_CONFIG_PATH="/overlayer/syshub/lib/pkgconfig:/overlayer/syshub/share/pkgconfig:${PKG_CONFIG_PATH:-}"
    export GI_TYPELIB_PATH="/overlayer/syshub/lib/girepository-1.0:/overlayer/syshub/share/girepository-1.0:${GI_TYPELIB_PATH:-}"
    export XDG_DATA_DIRS="/overlayer/syshub/share:${XDG_DATA_DIRS:-/usr/share}"

    meson setup builddir \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        -Dsystemd=false \
        -Dcamera_monitor=false \
        -Dextensions_tool=true \
        -Dextensions_app=true \
        -Dgtk_doc=false \
        -Dman=false \
        -Dtests=false \
        -Dnetworkmanager=false \
        -Dportal_helper=false \
        -Dintrospection=false

    ninja -C builddir

    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"

    mkdir -p "$PAYLOAD_DIR"

    cp -a "$inst"/. "$PAYLOAD_DIR"/
}
