maintainer="Ali Zain <alizain@zainiumdynamics.tech>"

pkgname=gnome-shell
pkgver=50.4
pkgrel=0

source="https://download.gnome.org/sources/gnome-shell/50/gnome-shell-$pkgver.tar.xz
0001-shell-elogind-support-to-avoid-stubbed-sd_notify.patch"

sha256sums="c531939539db316a41aef23670370abd1330d3254f84bcb0f9f4dae5d6e362cf  gnome-shell-$pkgver.tar.xz"

makedepends="
    elogind-dev
    mutter-dev
    evolution-data-server-dev
    gcr4-dev
    gjs-dev
    gnome-autoar-dev
    gnome-desktop-dev
    gobject-introspection-dev
    gstreamer-dev
    gtk4.0-dev
    ibus-dev
    json-glib-dev
    libcanberra-dev
    libxml2-dev
    libx11-dev
    libxext-dev
    libxfixes-dev
    pipewire-dev
    polkit-dev
    pulseaudio-dev
    sassc
    startup-notification-dev
"

build() {
    patch -p1 < ../0001-shell-elogind-support-to-avoid-stubbed-sd_notify.patch

    meson setup builddir \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        -Dsystemd=false \
        -Dcamera_monitor=false \
        -Dextensions_tool=true \
        -Dextensions_app=true \
        -Dgtk_doc=false \
        -Dman=false \
        -Dtests=false \
        -Dnetworkmanager=false \
        -Dportal_helper=false


    echo "=== MUTTER NEEDED ==="
    find builddir -name 'libmutter-cogl-18.so*' -exec sh -c '
        for f do
            echo "FILE: $f"
            readelf -d "$f" | grep NEEDED || true
        done
    ' sh {} \;

    echo "=== LIBRARIES ==="
    find /usr /overlayer/syshub \
        \( -name 'libglib-2.0.so*' \
        -o -name 'libgobject-2.0.so*' \
        -o -name 'libgio-2.0.so*' \
        -o -name 'libgraphene-1.0.so*' \
        -o -name 'libEGL.so*' \) \
        -print 2>/dev/null || true

    echo "=== PKGCONFIG ==="
    pkg-config --libs glib-2.0 || true
    pkg-config --libs gobject-2.0 || true
    pkg-config --libs graphene-1.0 || true
    pkg-config --libs egl || true

    ninja -C builddir
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"

    mkdir -p "$PAYLOAD_DIR"

    cp -a "$inst"/. "$PAYLOAD_DIR"/
}
