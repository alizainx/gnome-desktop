maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=libgsf
pkgver=1.14.58
pkgrel=0
# Autotools, ships a pregenerated ./configure - no autoreconf needed
# (Gentoo's GNOME2_EAUTORECONF and its one carried patch only touch
# perl test scripts we never run, not configure.ac). No
# systemd/elogind touchpoint at all (a structured-storage/OLE2/ZIP
# container library). gtk (gdk-pixbuf thumbnailing helpers) left off
# to minimize the dependency edge.
source="https://download.gnome.org/sources/libgsf/1.14/libgsf-$pkgver.tar.xz"
sha256sums="06e07ea12b7a52b9e316faddfecb640b1717a4875c59f0efb3b0cec1e2ccf35a  libgsf-$pkgver.tar.xz"
makedepends="glib-dev libxml2-dev zlib-dev"

build() {
    export ac_cv_path_PKG_CONFIG=pkg-config

    ./configure \
        --host="$CHOST" \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --disable-static \
        --without-bz2 \
        --disable-introspection \
        --without-gdk-pixbuf
    make
    make DESTDIR="$(pwd)/_zexbuild-install" install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    cp -a "$inst"/. "$PAYLOAD_DIR"/
}
